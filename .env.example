# ==============================================================================
# Jarvis Configuration Template
# Copy this file to '.env' and adjust the values for your local environment:
#   PowerShell:     Copy-Item .env.example .env
#   Command Prompt: copy .env.example .env
# ==============================================================================

# Assistant Identity
ASSISTANT_NAME=Jarvis

# AI Model Configuration (Ollama local inference)
MODEL_NAME=llama3.1
OLLAMA_HOST=http://localhost:11434

# API Key
# For local Ollama, you can set this to 'local' (or your proxy token if using one)
API_KEY=

# Speech-to-Text (Whisper) Configuration (Phase 2)
# Options for WHISPER_MODEL_SIZE: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base
WHISPER_LANGUAGE=en

# Text-to-Speech (TTS) Configuration (Phase 2)
# Natural edge-tts voice (e.g., en-GB-RyanNeural, en-US-GuyNeural, en-GB-SoniaNeural)
TTS_VOICE=en-GB-RyanNeural

# Wake Word Detection Configuration (Phase 4)
# Sensitivity threshold: lower is more sensitive, higher reduces false triggers (default: 0.5)
WAKE_THRESHOLD=0.5
# Higher wake threshold while speaking to prevent Jarvis's voice from triggering itself (default: 0.8)
INTERRUPT_THRESHOLD=0.8
WAKE_WORD_MODEL=hey_jarvis
# Global hotkey for manual activation / speech interrupt (default: <ctrl>+<alt>+j)
HOTKEY_COMBINATION=<ctrl>+<alt>+j

# Daily Briefing Configuration (Phase 5)
# Default city for weather forecast (Open-Meteo free API, no key required)
DEFAULT_CITY=New York
# Automatically give daily briefing on the first launch each day (default: false)
BRIEFING_ON_STARTUP=false

# Cost & Speed Controls (Phase 5)
# Daily token limit before pausing model calls (default: 200000; override by saying "override limit")
DAILY_TOKEN_LIMIT=200000
# Estimated price in USD per 1,000,000 input/output tokens
PRICE_PER_M_INPUT_TOKENS=0.15
PRICE_PER_M_OUTPUT_TOKENS=0.60
# Maximum tokens per response mode (shorter for voice, longer for text)
MAX_TOKENS_VOICE=300
MAX_TOKENS_TEXT=800

# Advanced Tuning & Safety Limits
WATCHDOG_TIMEOUT_SEC=60.0
FOLLOW_UP_TIMEOUT_SEC=6.0
MAX_MEMORIES_CAP=500
MAX_MEMORY_TEXT_LENGTH=300
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
MIN_SIMILARITY=0.35
ACTIONS_LOG_MAX_BYTES=1048576
ACTIONS_LOG_BACKUP_COUNT=3
AUDIO_SILENCE_THRESHOLD=0.015
AUDIO_SILENCE_LIMIT_SEC=1.5
AUDIO_MAX_RECORDING_SEC=30.0

# Vision & Screen Analysis (Phase 6)
# If true, saves temporary debug screenshots to screenshots/. If false, zero images are saved to disk.
KEEP_SCREENSHOTS=false
VISION_MODEL_NAME=llama3.2-vision
MAX_IMAGE_DIMENSION=1568
SENSITIVE_WINDOW_KEYWORDS=password,1password,bitwarden,keepass,lastpass,bank,banking,paypal,credit,checkout,login,signin,auth,keychain,vault,private,incognito

# Google Calendar (Read-Only)
CALENDAR_CREDENTIALS_FILE=data/secrets/credentials.json
CALENDAR_TOKEN_FILE=data/secrets/token.json
CALENDAR_WORK_HOURS_START=9
CALENDAR_WORK_HOURS_END=18
